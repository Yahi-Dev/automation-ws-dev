# =============================================================================
# automation-ws — plantilla de variables de entorno
#
# Copia este archivo a `.env` y rellena los valores. NUNCA versiones el `.env`.
# Las variables marcadas [OBLIGATORIA] deben existir para que la app arranque.
# Las demas son opcionales: si faltan, la app degrada a un modo mas simple
# (se indica cual en cada bloque).
# =============================================================================

# --- Despliegue con Docker Compose -------------------------------------------
# Solo se usan si despliegas con `docker compose up`. Con `npm run dev` sobran.
#
# Zona horaria. DEBE ser la misma para la app y el worker: si difieren, el
# rollup diario del dashboard se escribe con un dia y se consulta con otro,
# devuelve null siempre, y el dashboard cae al calculo en vivo sin avisar.
TZ="America/Santo_Domingo"

DOMINIO="ws.tudominio.com"
EMAIL_TLS="admin@tudominio.com"

MYSQL_ROOT_PASSWORD=""
MYSQL_DATABASE="automation_ws"
MYSQL_USER="automation"
MYSQL_PASSWORD=""
REDIS_PASSWORD=""

# Pool por proceso. La SUMA de todos debe ser menor que el max_connections de
# MySQL (60 en el compose). Sin definirlos, Prisma usa (nucleos*2+1) por proceso.
WORKER_DB_CONNECTION_LIMIT="6"

# --- Base de datos -----------------------------------------------------------
# [OBLIGATORIA] Cadena de conexion MySQL.
DATABASE_URL="mysql://usuario:password@127.0.0.1:3306/automation_ws"

# Replica de solo lectura. Si se define, el dashboard y los rollups leen de ella.
# Sin esto, leen del primario.
DATABASE_REPLICA_URL=""

# Tamano del pool de Prisma POR PROCESO. Sin definir, Prisma usa (nucleos*2+1),
# que en una maquina de 32 nucleos son 65 conexiones por proceso: con la app y
# el worker se supera el max_connections por defecto de MySQL (151).
# Regla: suma de todos los procesos < max_connections del servidor.
DB_CONNECTION_LIMIT="8"
DB_POOL_TIMEOUT="20"

# --- Autenticacion y URLs ----------------------------------------------------
# [OBLIGATORIA] Secreto de better-auth. Generar con: openssl rand -hex 32
BETTER_AUTH_SECRET=""
# [OBLIGATORIA] URL base publica de la app.
BETTER_AUTH_URL="http://localhost:3000"
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Logo usado en las plantillas de correo.
NEXT_PUBLIC_APP_URL_LOGO="http://localhost:3000/robot.png"

# --- Resolucion de la IP del cliente (rate-limit) ----------------------------
# TODA cabecera de IP la puede escribir el cliente. Solo son de confianza si hay
# un proxy delante que las reescribe. Por eso no se confia en ninguna por defecto.
#
# Ponlo a "true" SOLO si Cloudflare (o un proxy equivalente) esta delante y el
# origen NO es alcanzable directamente. Habilita cf-connecting-ip y x-real-ip.
TRUST_PLATFORM_HEADERS="false"
# Numero de proxies PROPIOS que anaden entrada a x-forwarded-for.
# 0 = trafico directo: no se confia en x-forwarded-for en absoluto.
TRUSTED_PROXY_HOPS="0"
# IPs o rangos CIDR de esos proxies, separados por coma (lo usa better-auth).
# Ej: "173.245.48.0/20,10.0.0.5"
TRUSTED_PROXY_IPS=""
#
# AVISO: si ninguna de estas variables describe tu topologia, la app NO podra
# resolver la IP y BLOQUEARA los intentos de login (fallo cerrado, a proposito).

# --- Cifrado de credenciales guardadas en la base de datos -------------------
# Clave de 64 caracteres hex (32 bytes) para cifrar los secretos de Twilio que
# se guardan desde la pantalla de Configuracion. Generar con: openssl rand -hex 32
#
# IMPORTANTE: definela ANTES de guardar credenciales. Si falta, se deriva de
# BETTER_AUTH_SECRET, y entonces rotar BETTER_AUTH_SECRET vuelve ILEGIBLES los
# secretos ya guardados.
SETTINGS_ENC_KEY=""

# --- Twilio ------------------------------------------------------------------
# Estas credenciales tambien pueden administrarse desde la pantalla de
# Configuracion (se guardan cifradas en la tabla app_settings y tienen
# PRIORIDAD sobre estas variables).
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# API Key opcional (solo la usa la Content API de plantillas, no el envio).
TWILIO_API_KEY_SID=""
TWILIO_API_KEY_SECRET=""
# Remitente de WhatsApp aprobado, en formato "whatsapp:+1..." o "+1...".
TWILIO_WHATSAPP_FROM=""
# Remitente del sandbox de Twilio, para pruebas (whatsapp:+14155238886).
TWILIO_PHONE_NUMBER=""
# Si se define, el envio va por el Messaging Service en vez de por el remitente.
TWILIO_MESSAGING_SERVICE_SID=""
TWILIO_CONTENT_BASE_URL="https://content.twilio.com/v1"
TWILIO_TEMPLATE_LANGUAGE_CODE="es"
TWILIO_TEMPLATE_DEFAULT_TYPE="twilio/text"
TWILIO_TEMPLATE_ALT_TEXT=""

# Validacion de la firma de los webhooks. Va activada por defecto; SOLO el
# valor literal "false" la desactiva. No la desactives en produccion.
TWILIO_VALIDATE_SIGNATURE="true"

# Circuit breaker de Twilio: fallos consecutivos antes de abrir, y enfriamiento.
TWILIO_BREAKER_THRESHOLD="5"
TWILIO_BREAKER_COOLDOWN_MS="30000"
# Timeout de las peticiones salientes al API de Twilio.
TWILIO_REQUEST_TIMEOUT_MS="15000"
# Origenes adicionales permitidos para la Content API (coma). Por defecto solo
# se admite https://content.twilio.com. Es la lista blanca que impide que un
# cambio en la URL base exfiltre las credenciales a otro host.
TWILIO_CONTENT_ALLOWED_ORIGINS=""

# --- Envio y consentimiento --------------------------------------------------
# Velocidad de envio. Los valores del cliente se acotan por WHATSAPP_MAX_BATCH_SIZE
# y WHATSAPP_MIN_DELAY_MS, que son el tope duro del servidor.
WHATSAPP_BATCH_SIZE="10"
WHATSAPP_SEND_DELAY_MS="1000"
WHATSAPP_MAX_BATCH_SIZE="100"
WHATSAPP_MIN_DELAY_MS="200"
# Mensajes procesados como maximo en cada pasada. Acota la memoria: sin tope, una
# campana de 500.000 destinatarios se hidrata entera (~300 MB) y tumba el worker.
WHATSAPP_MAX_PER_RUN="500"
# Intentos por mensaje antes de darlo por perdido. Los fallos PERMANENTES
# (opt-out, sin opt-in, telefono invalido, 21211/63003/131026) se cierran al
# primero, sin consumir intentos.
WHATSAPP_MAX_ATTEMPTS="3"

# Exigir opt-in explicito antes de enviar. Por defecto TRUE mientras no exista
# fila en app_settings. Solo "false" lo desactiva.
WHATSAPP_REQUIRE_OPT_IN="true"

# URL publica que recibe los callbacks de Twilio. Twilio NO alcanza localhost:
# en desarrollo usa un tunel (ngrok) y pon aqui esa URL. Si falta, los mensajes
# se quedan en "sent" para siempre porque nunca llega el estado de entrega.
WHATSAPP_WEBHOOK_BASE_URL=""
# Secreto compartido del webhook (viaja como ?token=).
WHATSAPP_WEBHOOK_SECRET=""
# Alternativa: URL completa del status callback (tiene prioridad sobre la base).
TWILIO_STATUS_CALLBACK_URL=""

# --- Cola y worker (BullMQ) --------------------------------------------------
# Redis TCP. ES LO QUE ACTIVA la cola, el worker y el envio programado.
# Sin esto, el envio ocurre de forma SINCRONA dentro del request y las campanas
# programadas NUNCA se disparan.
# Aviso: se ignora si el valor contiene "XXXX", "your-", "example" o "changeme".
REDIS_URL=""
BULLMQ_REDIS_URL=""
WORKER_CAMPAIGN_CONCURRENCY="5"
WORKER_WEBHOOK_CONCURRENCY="20"
# Pasadas maximas por job de campana (cada una procesa WHATSAPP_MAX_PER_RUN).
WORKER_MAX_PASADAS="200"
# Margen de cierre ordenado antes de forzarlo. Debe ser MENOR que el periodo de
# gracia del orquestador (30 s en Kubernetes, 10 s en `docker stop`).
WORKER_SHUTDOWN_TIMEOUT_MS="25000"

# Token que protege POST /api/whatsapp/dispatch y GET /api/metrics/queues.
CRON_SECRET=""

# --- Cache y rate-limit distribuidos (Upstash, opcional) ---------------------
# Sin esto, la cache y los contadores de rate-limit viven en memoria POR PROCESO.
# Es correcto con una sola instancia; con dos o mas, hacen falta.
# Nota: el cliente REST de Upstash NO sirve para BullMQ (necesita Redis TCP).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# Cota del cache en memoria (numero de entradas). Sin Upstash, este mapa es el
# camino ACTIVO, no un modo degradado: sin cota crecia hasta agotar el heap.
MEM_CACHE_MAX_ENTRIES="5000"
# Ventana anti-replay de los webhooks de Twilio, en segundos. La firma de Twilio
# no lleva marca temporal ni nonce, asi que una peticion capturada se puede
# reenviar indefinidamente si no se recuerda que ya se proceso.
WEBHOOK_REPLAY_TTL_SECONDS="86400"

# --- Almacenamiento de archivos (S3 / Cloudflare R2, opcional) ---------------
# Las tres primeras son necesarias para activarlo. Sin ellas, las imagenes se
# guardan en public/uploads/ (no durable, no sirve con varias instancias).
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_PUBLIC_BASE_URL=""
S3_FORCE_PATH_STYLE="true"

# --- Correo saliente (SMTP) --------------------------------------------------
MAIL_HOST=""
MAIL_PORT="587"
MAIL_USERNAME=""
MAIL_PASSWORD=""
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="Automation WS"
# Acepta certificados TLS no verificables. SOLO para un SMTP local de
# desarrollo: en produccion expone los enlaces de restablecimiento de
# contrasena a quien pueda interponerse.
MAIL_ALLOW_SELF_SIGNED="false"

# --- Observabilidad ----------------------------------------------------------
SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE="0.05"
LOG_LEVEL="info"
# Nombre del proceso en los logs: "app" o "worker".
SERVICE_NAME="app"

# --- Limites de importacion --------------------------------------------------
CONTACTS_IMPORT_MAX_BYTES="5242880"
CONTACTS_IMPORT_MAX_ROWS="50000"

# --- Formulario de contacto --------------------------------------------------
# Lista JSON de codigos de pais ISO aceptados. Ej: ["DO","US","MX"]
CONTACT_FORM_COUNTRIES_ACCEPT='["DO"]'

# --- Semilla y arranque en frio ---------------------------------------------
# Usuarios a sembrar con `npm run db:seed`. JSON. Solo para entorno local.
SEED_USERS='[]'

# Correo del usuario que sera promovido a administrador aprobado.
# Sin esto no hay forma de crear el PRIMER admin: tanto el registro publico como
# el seeder crean usuarios "pending"/"user", y el endpoint que promueve exige ya
# ser admin. Se aplica con `npm run db:bootstrap-admin` (o con `db:seed`), es
# idempotente y no hace nada si ya existe algun administrador aprobado.
BOOTSTRAP_ADMIN_EMAIL=""
