# Imagen del WORKER (BullMQ).
#
# Es el proceso que hace que funcionen las campañas programadas: sin él,
# `posts.schedule` solo pinta una etiqueta y nadie despacha nada.
#
# No usa la salida standalone de Next porque no sirve páginas: ejecuta
# src/worker/index.ts con tsx.

FROM node:22-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

FROM node:22-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV SERVICE_NAME=worker

RUN addgroup --system --gid 1001 nodejs \
 && adduser --system --uid 1001 worker

COPY --from=deps --chown=worker:nodejs /app/node_modules ./node_modules
COPY --chown=worker:nodejs package.json ./
COPY --chown=worker:nodejs prisma ./prisma
COPY --chown=worker:nodejs src ./src
COPY --chown=worker:nodejs tsconfig.json ./

RUN npx prisma generate

USER worker

# El worker NO aplica migraciones: de eso se encarga el contenedor de la app.
# Si ambos lo hicieran, dos procesos competirían por el lock de migración.
CMD ["npx", "tsx", "src/worker/index.ts"]
